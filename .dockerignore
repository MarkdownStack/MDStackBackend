# Local virtualenv / caches — never needed in the build context, the
# Dockerfile builds its own venv from pyproject.toml + uv.lock.
.venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache

# Version control
.git
.gitignore

# Real secrets — MUST NOT end up in the image. Only .env.example (which
# holds placeholders) is meant to be visible to anything, and even that
# isn't needed at build time.
.env
.env.*
!.env.example

# Editor / OS cruft
.idea
.vscode
.DS_Store

# Leftover/removed code not wired into main.py — see routers/graph.py
# discussion; excluding it keeps the image from shipping dead code.
_removed

# Docker's own files don't need to be in their own build context
Dockerfile
.dockerignore
