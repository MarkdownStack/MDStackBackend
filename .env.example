MONGO_URL=mongodb://localhost:27017
DB_NAME=vault
CORS_ORIGINS=http://localhost:5173

# Auth
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Mailgun (app/email.py) — sends the "verify your email" link on
# signup. Without all three set, registration still succeeds but the email
# is skipped (logged as a warning) — see send_verification_email.
# Full "…/v3/<domain>/messages" endpoint (not just a bare domain).
MAILGUN_URI=https://api.mailgun.net/v3/app.stalk-my-money.in/messages
MAILGUN_API_KEY=change-this-to-your-mailgun-private-api-key
MAILGUN_FROM_ADDR=parimal@app.stalk-my-money.in

# Where the frontend is actually served — used to build the verification
# link embedded in the email (the link is a frontend route, /verify-email,
# not a backend one).
FRONTEND_BASE_URL=http://localhost:5173

# Comma-separated list of emails allowed to access the admin dashboard
# (GET /api/admin/stats and the /admin page in the frontend). See
# app/dependencies.py's ADMIN_EMAILS/is_admin_email.
ADMIN_EMAILS=you@example.com

# USA Oregon
# vyamshu_db_user
# GoyjvkZibxCzqNjD

# IND Mumbai
# testclaude4653_db_user
# imVI4AhRh7hpthxl
# mongodb+srv://testclaude4653_db_user:imVI4AhRh7hpthxl@cluster0.otuleco.mongodb.net/?appName=Cluster0

# ---- MCP server (mcp_server/) — only used when running it in "http" mode,
# e.g. the `mcp` service in docker-compose.yml for a remote/EC2 deployment.
# Not read at all when running locally via stdio (Claude Desktop's normal
# local config) — see mcp_server/README.md.
#
# Shared secret every remote MCP client must send as its bearer token.
# Generate a real one with: openssl rand -hex 32
MDSTACK_MCP_TOKEN=change-this-to-a-long-random-string

# So the vault tools work without an interactive auth_login call on every
# session — pick ONE of these two ways to authenticate as your own vault:
# MDSTACK_ACCESS_TOKEN=a-pre-issued-jwt
# MDSTACK_EMAIL=you@example.com
# MDSTACK_PASSWORD=your-password
