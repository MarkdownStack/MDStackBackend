# Local Docker override — passed via --env-file .env.local to docker compose.
# Overrides DATABASE_URL so the backend container reaches the postgres
# container over the compose network's internal DNS instead of localhost
# (which inside a container means itself, not the postgres container).
# The rest of the config still comes from .env via env_file: in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://mdstack:mdstack@postgres:5432/mdstack
